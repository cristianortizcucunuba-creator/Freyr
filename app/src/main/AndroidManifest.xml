<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".FreyrApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_freyr_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_freyr_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Freyr">

        <!-- Splash / Startup Screen with Detailed Freyr Logo -->
        <activity
            android:name=".Clases.PantallaInicio"
            android:theme="@style/Theme.Freyr.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Dashboard Activity with Bottom Navigation -->
        <activity
            android:name=".Clases.ActividadPrincipal"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Authentication -->
        <activity
            android:name=".Clases.autenticacion.LoguearUsuario"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Clases.autenticacion.RegistrarUsuario"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Debt Operations -->
        <activity
            android:name=".Clases.deuda.AñadirDeuda"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Clases.deuda.DetallesDeuda"
            android:exported="false" />

        <activity
            android:name=".Clases.deuda.RegistrarAbonosDeuda"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Family Groups -->
        <activity
            android:name=".Clases.grupo.CrearGrupoFamiliar"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Clases.grupo.ConfigurarCuentaFamiliar"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- User Profile -->
        <activity
            android:name=".Clases.perfil.VerPerfilActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Clases.perfil.ActividadEditarPerfil"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>