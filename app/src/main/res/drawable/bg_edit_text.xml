<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/freyr_surface" />
            <stroke android:width="2dp" android:color="@color/freyr_primary" />
            <padding android:bottom="12dp" android:left="14dp" android:right="14dp" android:top="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/freyr_surface" />
            <stroke android:width="1dp" android:color="@color/freyr_border" />
            <padding android:bottom="12dp" android:left="14dp" android:right="14dp" android:top="12dp" />
        </shape>
    </item>
</selector>
