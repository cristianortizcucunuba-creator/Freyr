<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/freyr_background">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finanzas Personales"
                android:textColor="@color/freyr_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestiona tus gastos"
                android:textColor="@color/freyr_card_bg"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_add_personal_debt"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_primary"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="+ Añadir Deuda"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Filter tabs -->
    <RadioGroup
        android:id="@+id/rg_debt_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_button_secondary"
        android:padding="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp">

        <RadioButton
            android:id="@+id/rb_filter_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/freyr_primary"
            android:checked="true"
            android:text="Todas"
            android:textColor="@color/freyr_text_primary"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb_filter_pending"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/freyr_primary"
            android:text="Pendientes"
            android:textColor="@color/freyr_text_primary"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb_filter_paid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/freyr_primary"
            android:text="Pagas"
            android:textColor="@color/freyr_text_primary"
            android:textSize="12sp" />
    </RadioGroup>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_personal_debts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false" />

</LinearLayout>
