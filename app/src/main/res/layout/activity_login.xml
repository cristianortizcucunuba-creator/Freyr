<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/freyr_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Logotipo de la Marca -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_button_primary">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="F"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Freyr"
            android:textColor="@color/freyr_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textColor="@color/freyr_text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- Tarjeta del formulario de ingreso -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/freyr_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_login"
                    android:textColor="@color/freyr_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tx_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D32F2F"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <!-- Usuario o Correo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuario o Correo Electrónico"
                    android:textColor="@color/freyr_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_identifier"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="juan o juan@ejemplo.com"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/freyr_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp" />

                <!-- Contraseña -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_password"
                    android:textColor="@color/freyr_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/freyr_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp" />

                <!-- Botón de Inicio de Sesión -->
                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="@string/btn_login"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Enlace para Crear Cuenta -->
                <TextView
                    android:id="@+id/tx_go_to_register"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿No tienes una cuenta? Regístrate aquí"
                    android:textColor="@color/freyr_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/freyr_secondary"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp" />

                <!-- Botones de prueba rápida -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cuentas de prueba rápida (Toca para autocompletar):"
                    android:textColor="@color/freyr_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_juan"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Juan"
                        android:textSize="11sp"
                        android:background="@drawable/bg_button_secondary"
                        android:textColor="@color/freyr_primary"
                        android:layout_marginEnd="4dp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_maria"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="María"
                        android:textSize="11sp"
                        android:background="@drawable/bg_button_secondary"
                        android:textColor="@color/freyr_primary"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btn_carlos"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Carlos"
                        android:textSize="11sp"
                        android:background="@drawable/bg_button_secondary"
                        android:textColor="@color/freyr_primary"
                        android:layout_marginStart="4dp"
                        app:backgroundTint="@null" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>

