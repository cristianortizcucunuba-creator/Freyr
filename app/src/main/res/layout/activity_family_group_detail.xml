<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/freyr_background">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_volver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="@string/btn_back"
            app:tint="@color/freyr_primary" />

        <TextView
            android:id="@+id/texto_titulo_grupo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Detalle del grupo familiar"
            android:textColor="@color/freyr_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btn_agregar_deuda_grupo"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ Añadir deuda"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:textColor="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tarjeta de saldos compartidos del grupo -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/freyr_surface"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SALDO FAMILIAR COMPARTIDO"
                        android:textColor="@color/freyr_text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/total_debido"
                                android:textColor="@color/freyr_text_secondary"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/texto_total_deuda_grupo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0"
                                android:textColor="@color/freyr_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/total_pagado"
                                android:textColor="@color/freyr_text_secondary"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/texto_total_pagado_grupo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0"
                                android:textColor="@color/freyr_status_paid"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/total_pendiente"
                                android:textColor="@color/freyr_text_secondary"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/texto_saldo_pendiente_grupo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0"
                                android:textColor="@color/freyr_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Lista de miembros y formulario de invitación -->
            <TextView
                android:id="@+id/tv_members_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIEMBROS"
                android:textColor="@color/freyr_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/texto_lista_miembros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Juan Pérez (Admin), María González"
                android:textColor="@color/freyr_text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <!-- Caja de envío de invitación -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/freyr_surface"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Invitar miembro"
                        android:textColor="@color/freyr_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/identificador_invitacion"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edit_text"
                            android:hint="Usuario o correo (Ej. carlos)"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/freyr_text_primary"
                            android:textSize="13sp"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/enviar_invitacion"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="Invitar"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_button_primary"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="@null" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/texto_resultado_invitacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:visibility="gone"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Lista de deudas familiares compartidas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEUDAS FAMILIARES COMPARTIDAS"
                android:textColor="@color/freyr_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/texto_sin_deudas_grupo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No hay deudas familiares registradas en este grupo aún."
                android:textColor="@color/freyr_text_secondary"
                android:textSize="12sp"
                android:padding="16dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_visual_deudas_grupo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>

