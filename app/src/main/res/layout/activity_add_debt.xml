<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/freyr_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado superior con botón de regreso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_atras"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="@string/btn_back"
                app:tint="@color/freyr_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_add_debt"
                android:textColor="@color/freyr_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Banner de mensaje de error -->
        <TextView
            android:id="@+id/tx_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Selector de ámbito de deuda (Personal vs Familiar) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Tipo de deuda"
            android:textColor="@color/freyr_card_bg"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_tipo_deuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_secondary"
            android:padding="4dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_deuda_personal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/debt_scope_personal"
                android:checked="true"
                android:textColor="@color/freyr_text_primary"
                android:buttonTint="@color/freyr_primary" />

            <RadioButton
                android:id="@+id/rb_deuda_familiar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/debt_scope_family"
                android:textColor="@color/freyr_text_primary"
                android:buttonTint="@color/freyr_primary" />
        </RadioGroup>

        <!-- 1. Nombre o concepto de la deuda -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/label_debt_name"
            android:textColor="@color/freyr_card_bg"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_nombre_deuda"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:hint="@string/hint_debt_name"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:cursorVisible="true"
            android:importantForAutofill="no"
            android:textColor="@color/freyr_text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- 2. Monto total de la deuda -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/label_debt_amount"
            android:textColor="@color/freyr_card_bg"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_monto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:hint="@string/hint_debt_amount"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:cursorVisible="true"
            android:importantForAutofill="no"
            android:textColor="@color/freyr_text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Opciones de grupo familiar (Visible cuando se selecciona Deuda Familiar) -->
        <LinearLayout
            android:id="@+id/layout_family_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_debt_group"
                android:textColor="@color/freyr_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_family_group"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_edit_text"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_assigned_member"
                android:textColor="@color/freyr_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_assigned_member"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_edit_text" />
        </LinearLayout>

        <!-- 3. Descripción y notas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/label_debt_description"
            android:textColor="@color/freyr_card_bg"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_descripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:maxLines="4"
            android:gravity="top|start"
            android:background="@drawable/bg_edit_text"
            android:hint="@string/hint_debt_description"
            android:inputType="textMultiLine"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:cursorVisible="true"
            android:importantForAutofill="no"
            android:textColor="@color/freyr_text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Botón Guardar Deuda -->
        <Button
            android:id="@+id/btn_guardar_deuda"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/btn_save_debt"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>

