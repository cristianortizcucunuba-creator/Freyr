<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/freyr_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_atras"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="@string/btn_back"
                app:tint="@color/freyr_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_add_payment"
                android:textColor="@color/freyr_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Tarjeta de estado de saldo -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/freyr_surface"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_for_debt_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Para: Deuda"
                    android:textColor="@color/freyr_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_debido"
                            android:textColor="@color/freyr_text_secondary"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tv_status_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$3,000,000"
                            android:textColor="@color/freyr_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_pagado"
                            android:textColor="@color/freyr_text_secondary"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tv_status_paid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$1,000,000"
                            android:textColor="@color/freyr_status_paid"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_pendiente"
                            android:textColor="@color/freyr_text_secondary"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tv_status_remaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$2,000,000"
                            android:textColor="@color/freyr_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Mensaje de error -->
        <TextView
            android:id="@+id/tx_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Campo de monto del abono -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_payment_amount"
                android:textColor="@color/freyr_card_bg"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_pay_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pagar saldo total"
                android:textColor="@color/freyr_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_payment_amount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:hint="000000"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@color/freyr_text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_projected_remaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/freyr_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <!-- Campo de fecha de abono -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/label_payment_date"
            android:textColor="@color/freyr_card_bg"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_payment_date"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:hint="AAAA-MM-DD"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/freyr_text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <!-- Campo de nota o descripción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/label_payment_note"
            android:textColor="@color/freyr_card_bg"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_payment_desc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:hint="Descripción"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/freyr_text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Botón de confirmar abono -->
        <Button
            android:id="@+id/btn_confirm_payment"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/btn_save_payment"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>

