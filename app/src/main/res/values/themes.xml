<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Freyr" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 1. Barra de estado Ciruela para TODAS las pantallas de la app -->
        <item name="android:statusBarColor">#550724</item>

        <!-- 2. 'false' hace que la hora, batería y wifi sean SIEMPRE blancos -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Colores base de la marca -->
        <item name="colorPrimary">#550724</item>
        <item name="colorPrimaryVariant">#42091D</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowBackground">#FAF5F2</item>
    </style>

    <style name="Theme.Freyr.Splash" parent="Theme.Freyr">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>